{
  "buildCommand": "npm run build",
  "outputDirectory": "app/frontend/dist",
  "installCommand": "echo skip",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
